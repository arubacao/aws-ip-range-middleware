{
    "name": "arubacao/aws-ip-range-middleware",
    "description": "Laravel Middleware for Amazon Web Services (AWS) IP Address Range",
    "keywords": [
        "laravel",
        "aws",
        "ip-range",
        "middleware"
    ],
    "homepage": "https://github.com/arubacao/aws-ip-range-middleware",
    "license": "MIT",
    "authors": [
        {
            "name": "Christopher Lass",
            "homepage": "https://github.com/arubacao"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/cache": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "symfony/http-foundation": "^6.0|^7.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^1.11|^2.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Arubacao\\AwsIpRange\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arubacao\\AwsIpRange\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "style": "vendor/bin/pint --test",
        "style:fix": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arubacao\\AwsIpRange\\AwsIpRangeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
